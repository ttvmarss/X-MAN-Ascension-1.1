# Required API Keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here
FISH_API_KEY=your-fish-audio-api-key-here

# Optional: Your name (JARVIS will address you personally)
USER_NAME=Tony

# Optional: Fish Audio voice model ID (default is a JARVIS-like voice)
FISH_VOICE_ID=3b554ef0ee6748e7a1bba6e6f87e4aea

# Optional: Server config
HOST=localhost
PORT=8000

# Optional: Outlook integration (leave blank to use file-based fallback)
# Set to "outlook" to use Microsoft Outlook COM automation
# Set to "file" to use simple JSON/text file fallback
CALENDAR_BACKEND=auto
MAIL_BACKEND=auto

# Optional: Notes storage path (default: ~/Documents/JARVIS Notes)
NOTES_PATH=

# Optional: Path to Claude Code CLI (default: auto-detected)
CLAUDE_CODE_PATH=

# Optional: Enable screen awareness (requires Pillow)
SCREEN_AWARENESS=true

# Optional: Projects directory for Claude Code builds
PROJECTS_DIR=~/Documents/JARVIS Projects
