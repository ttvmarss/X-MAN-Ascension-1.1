# ── Required ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── Recommended (cinematic JARVIS voice) ──────────────────────────
# Without this, JARVIS uses the browser's built-in TTS (George on Windows, Daniel on iOS)
FISH_API_KEY=your-fish-audio-api-key-here
FISH_VOICE_ID=3b554ef0ee6748e7a1bba6e6f87e4aea

# ── Personal ──────────────────────────────────────────────────────
USER_NAME=Tony

# ── Server / networking ───────────────────────────────────────────
HOST=0.0.0.0                # 0.0.0.0 = phone can reach it; 127.0.0.1 = PC only
PORT=8000
USE_HTTPS=auto              # auto | true | false  (iPhone mic access requires HTTPS)

# ── Speech-to-text (used for iPhone) ──────────────────────────────
# Options: tiny.en (fastest), base.en (default), small.en, medium.en (most accurate)
WHISPER_MODEL=base.en

# ── Backends (auto-detects Outlook if installed) ─────────────────
CALENDAR_BACKEND=auto       # auto | outlook | file
MAIL_BACKEND=auto

# ── Optional paths ────────────────────────────────────────────────
NOTES_PATH=
CLAUDE_CODE_PATH=
PROJECTS_DIR=
SCREEN_AWARENESS=true
