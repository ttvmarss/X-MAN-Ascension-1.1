# ── Required ──────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── Personal ──────────────────────────────────────────────────────
USER_NAME=Tony

# ── JARVIS Voice (FREE — via Microsoft Edge neural voices) ────────
# No API key needed. Voice quality is excellent.
# Options: en-GB-RyanNeural   (recommended — British, JARVIS-like)
#          en-GB-ThomasNeural (alt British male)
#          en-US-GuyNeural    (American male)
#          en-US-TonyNeural   (American male, deeper)
#          en-GB-SoniaNeural  (British female)
JARVIS_VOICE=en-GB-RyanNeural
JARVIS_RATE=+0%
JARVIS_PITCH=-5%

# ── Server / networking ───────────────────────────────────────────
HOST=0.0.0.0          # 0.0.0.0 lets your phone reach it. 127.0.0.1 = PC only.
PORT=8000
USE_HTTPS=auto        # auto = self-signed cert (required for iPhone mic)

# ── Claude model ──────────────────────────────────────────────────
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ── Optional ──────────────────────────────────────────────────────
CLAUDE_CODE_PATH=     # path to claude code CLI; "claude" auto-detected if on PATH
WHISPER_MODEL=base.en # only used if you install nodejs-whisper for iOS STT
