# ============================================================
#  JARVIS — Environment Configuration
#  Copy this to .env and fill in your keys
# ============================================================

# ── AI BRAIN (pick ONE — both are free) ─────────────────────

# OPTION A: Groq (FREE — just email signup, no credit card)
# Sign up at: console.groq.com → API Keys → Create
GROQ_API_KEY=

# OPTION B: Anthropic Claude (free tier available)
# Sign up at: console.anthropic.com
ANTHROPIC_API_KEY=

# ── VOICE (optional — browser voice is used if not set) ──────

# Fish Audio TTS key — gives JARVIS his MCU voice
# Free at: fish.audio → click API Keys
# Leave blank to use your browser's built-in voice (also works fine)
FISH_API_KEY=

# Fish Audio voice model (default = JARVIS MCU voice)
# FISH_VOICE_ID=612b878b113047d9a770c069c8b4fdfe

# ── OPTIONAL ─────────────────────────────────────────────────

# Your name (JARVIS will use this)
# USER_NAME=

# Your city for weather (blank = auto-detect)
# WEATHER_LOCATION=

# Security token for remote/public access
# AUTH_TOKEN=

# Server port (default 8340)
# PORT=8340
