# ============================================================
#  JARVIS — Environment Configuration
# ============================================================

# ── REQUIRED ────────────────────────────────────────────────

# Anthropic API key (get at console.anthropic.com)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Fish Audio TTS key (get at fish.audio) — used for JARVIS voice
FISH_API_KEY=your-fish-audio-api-key-here

# ── OPTIONAL — Personalization ───────────────────────────────

# Your name (JARVIS will address you by this)
# USER_NAME=Tony

# Fish Audio voice model ID (defaults to JARVIS MCU voice)
# FISH_VOICE_ID=612b878b113047d9a770c069c8b4fdfe

# ── OPTIONAL — Remote Access Security ───────────────────────
# Set this when deploying to a cloud server accessible from the internet.
# JARVIS will require this token on all API/WebSocket connections.
# Leave blank for local-only use.
# AUTH_TOKEN=change-this-to-a-long-random-secret

# ── OPTIONAL — Location / Weather ───────────────────────────
# Your city for weather context (blank = auto-detect from IP)
# WEATHER_LOCATION=New York

# ── OPTIONAL — macOS Calendar (macOS only) ──────────────────
# Specific Apple Calendar accounts (comma-separated emails)
# Leave blank to read ALL calendars
# CALENDAR_ACCOUNTS=you@gmail.com,work@company.com

# ── WINDOWS PC AGENT (runs on your Windows PC, not the server) ──
# Set this on your Windows machine's copy of windows_agent.py
# JARVIS_SERVER=wss://your-cloud-server-ip:8340/ws/pc
